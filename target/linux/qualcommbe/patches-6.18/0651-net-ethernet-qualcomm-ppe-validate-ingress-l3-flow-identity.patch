+}
+
+static int ppe_ft_vlan_port_put(struct ppe_flowtable *ft, int port)
+{
+	struct ppe_ft_vlan_port *state = &ft->vlan_ports[port];
+	int ret;
+
+	if (WARN_ON(!state->refs) || state->poisoned)
+		return -EIO;
+	if (state->refs > 1) {
+		state->refs--;
+		return 0;
+	}
+	ret = ppe_ft_vlan_port_restore(ft, port);
+	if (ret) {
+		state->poisoned = true;
+		dev_err(ft->ppe_dev->dev,
+			"quarantining VLAN ingress port %d: %d\n", port, ret);
+		return ret;
+	}
+	memset(state, 0, sizeof(*state));
+	return 0;
+}
+
+static int ppe_ft_port_l3_if_set(struct ppe_flowtable *ft, int port, int l3_if)
+{
+	if ((unsigned int)port < ARRAY_SIZE(ft->vlan_ports)) {
+		struct ppe_ft_vlan_port *state = &ft->vlan_ports[port];
