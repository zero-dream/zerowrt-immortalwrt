 {
-	u32 reg = PPE_IN_L3_IF_TBL_ADDR + PPE_IN_L3_IF_TBL_INC * index +
-		  sizeof(u32);
-	u32 mask;
+	u32 reg = PPE_IN_L3_IF_TBL_ADDR + PPE_IN_L3_IF_TBL_INC * index;
+	u32 val[3], readback, mask;
+	int ret;
 
-	if (my_mac < 0 || my_mac >= PPE_MY_MAC_TBL_ENTRIES)
+	if (index < 0 || index >= PPE_IN_L3_IF_TBL_ENTRIES ||
+	    my_mac < 0 || my_mac >= PPE_MY_MAC_TBL_ENTRIES)
 		return -EINVAL;
 
 	mask = FIELD_PREP(PPE_IN_L3_IF_W1_MAC_BITMAP, BIT(my_mac));
-	return regmap_update_bits(ppe_dev->regmap, reg, mask,
-				  enable ? mask : 0);
+	ret = regmap_bulk_read(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+	if (ret)
+		return ret;
+	if (!!(val[1] & mask) == enable)
+		return 0;
+
+	/* Use the SSDK table transaction, preserving route/MTU/PPPoE state.
+	 * A successful MMIO write alone does not prove that the binding stuck.
+	 */
+	val[1] = (val[1] & ~mask) | (enable ? mask : 0);
+	ret = regmap_bulk_write(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+	if (ret)
+		return ret;
+	ret = regmap_read(ppe_dev->regmap, reg + sizeof(u32), &readback);
+	if (ret)
+		return ret;
+	if ((readback & mask) != (val[1] & mask)) {
