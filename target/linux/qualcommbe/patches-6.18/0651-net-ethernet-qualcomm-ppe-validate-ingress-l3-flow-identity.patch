+	 * must leave the fallback live, and its reserved resources quarantined.
+	 */
+	ret = ppe_port_l3_if_set(ft->ppe_dev, port, state->saved_l3);
+	if (ret)
+		return ret;
+	ret = ppe_ing_xlt_rule_clear(ft->ppe_dev, ppe_ft_vlan_port_xlt(port));
