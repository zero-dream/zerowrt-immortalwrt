+		/* Reverse-direction egress setup must not re-enable the physical
+		 * binding while ingress VLANs still select L3 through their VSI.
+		 */
+		if (state->refs)
+			return 0;
+	}
+
+	return ppe_port_l3_if_set(ft->ppe_dev, port, l3_if);
+}
