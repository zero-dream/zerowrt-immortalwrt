+/* Retain an existing QCA mapping without creating a mapping or an RX hook. */
+int ppe_vp_ref_qca4b(struct ppe_device *ppe_dev, int vp, int physical_port)
+{
+	struct ppe_vp *vpt = ppe_dev->vp;
+	struct ppe_vp_slot *slot;
+	int i = vp - PPE_VP_PORT_BASE;
+	int ret = -ENODEV;
+
+	if (!vpt || i < 0 || i >= PPE_VP_SLOTS)
+		return -EINVAL;
+
+	mutex_lock(&vpt->lock);
+	slot = &vpt->slots[i];
+	if (!vpt->inject_disabled && slot->refcnt &&
+	    rcu_access_pointer(slot->dev) &&
+	    slot->type == PPE_VP_SLOT_QCA4B && !slot->poisoned &&
+	    slot->physical_port == physical_port) {
+		slot->refcnt++;
+		ret = 0;
+	}
+	mutex_unlock(&vpt->lock);
+
+	return ret;
+}
