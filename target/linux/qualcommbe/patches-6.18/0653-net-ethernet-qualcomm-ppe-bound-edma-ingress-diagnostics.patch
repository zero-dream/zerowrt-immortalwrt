From: ViKing <viking.yfy@qq.com>
Subject: [PATCH] net: ethernet: qualcomm: ppe: bound EDMA ingress diagnostics

Record EDMA source-check failures with bounded diagnostics. Aggregate code 89 and no-route code 162 events so unusual descriptors remain attributable without flooding the kernel log.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/edma_rx.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_rx.c
@@ -13,6 +13,7 @@
 #include <linux/netdevice.h>
 #include <linux/platform_device.h>
 #include <linux/printk.h>
+#include <linux/ratelimit.h>
 #include <linux/regmap.h>
 
 #include "edma.h"
@@ -28,6 +29,55 @@
 static bool edma_rx_deliver_vp(struct edma_rxdesc_pri *rxdesc_pri,
 			       struct sk_buff *skb);
 
+/* Keep source-check failures attributable without logging every punt. The
+ * validity flag belongs to the primary descriptor; the code and flow index
+ * belong to the coherent secondary ring, as in QSDK EDMA v2.
+ */
+static void edma_rx_ingress_check_debug(struct edma_rxdesc_ring *ring,
+					struct edma_rxdesc_pri *desc)
+{
+	static struct ratelimit_state rate =
+		RATELIMIT_STATE_INIT_FLAGS(rate, 60 * HZ, 1,
+					   RATELIMIT_MSG_ON_RELEASE);
+	static atomic_t pending = ATOMIC_INIT(0);
+	static struct ratelimit_state no_route_rate =
+		RATELIMIT_STATE_INIT_FLAGS(no_route_rate, 60 * HZ, 1,
+					   RATELIMIT_MSG_ON_RELEASE);
+	static atomic_t no_route_pending = ATOMIC_INIT(0);
+	struct ratelimit_state *selected_rate;
+	atomic_t *selected_pending;
+	struct edma_rxdesc_sec *sec;
+	u32 flags, flow, code, src, dst;
+	unsigned int index;
+
+	flags = le32_to_cpu((__force __le32)desc->word1);
+	if (!(flags & EDMA_RXDESC_CPU_CODE_VALID))
+		return;
+	index = desc - (struct edma_rxdesc_pri *)ring->pdesc;
+	sec = EDMA_RXDESC_SEC_DESC(ring, index);
+	code = FIELD_GET(EDMA_RXSDESC_CPU_CODE,
+			 le32_to_cpu((__force __le32)sec->word5));
+	if (code != 89 && code != 162)
+		return;
+	selected_rate = code == 89 ? &rate : &no_route_rate;
+	selected_pending = code == 89 ? &pending : &no_route_pending;
+	atomic_inc(selected_pending);
+	if (!__ratelimit(selected_rate))
+		return;
+	flow = le32_to_cpu((__force __le32)sec->word3);
+	src = EDMA_RXDESC_SRC_INFO_GET(desc);
+	dst = EDMA_RXDESC_DST_INFO_GET(desc);
+	dev_warn(edma_ctx->ppe_dev->dev,
+		 "ingress check punt: code=%u interval-packets=%u src=%04x dst=%04x flow=%lu valid=%u vlan=%08x/%08x offsets=%08x/%08x\n",
+		 code, (u32)atomic_xchg(selected_pending, 0), src, dst,
+		 FIELD_GET(EDMA_RXSDESC_FLOW_INDEX, flow),
+		 !!(flow & EDMA_RXSDESC_FLOW_VALID),
+		 le32_to_cpu((__force __le32)sec->word6),
+		 le32_to_cpu((__force __le32)sec->word7),
+		 le32_to_cpu((__force __le32)desc->word7),
+		 le32_to_cpu((__force __le32)sec->word4));
+}
+
 static int edma_rx_alloc_buffer_list(struct edma_rxfill_ring *rxfill_ring, int alloc_count)
 {
 	struct edma_rxfill_stats *rxfill_stats = &rxfill_ring->rxfill_stats;
@@ -705,6 +755,8 @@
 			int src_vp;
 			u32 src_info;
 
+			edma_rx_ingress_check_debug(rxdesc_ring, rxdesc_pri);
+
 			/* A frame the hardware handed the CPU with a virtual port
 			 * as its source - an anomalous injected-flow miss or a
 			 * routed wireless-to-wireless flow -
--- a/drivers/net/ethernet/qualcomm/ppe/edma_rx.h
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_rx.h
@@ -80,6 +80,11 @@
 #define EDMA_RXDESC_SRC_INFO_GET(desc)	FIELD_GET(EDMA_RXDESC_SRC_INFO_MASK, \
 					le32_to_cpu((__force __le32)((desc)->word4)))
 
+#define EDMA_RXDESC_CPU_CODE_VALID	BIT(12)
+#define EDMA_RXSDESC_CPU_CODE		GENMASK(25, 16)
+#define EDMA_RXSDESC_FLOW_VALID		BIT(21)
+#define EDMA_RXSDESC_FLOW_INDEX		GENMASK(19, 0)
+
 #define EDMA_RXDESC_PORT_ID_MASK	GENMASK(11, 0)
 #define EDMA_RXDESC_PORT_ID_GET(x)	FIELD_GET(EDMA_RXDESC_PORT_ID_MASK, x)
 
