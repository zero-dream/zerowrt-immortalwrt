#define IPS_DST_NAT 32
#define IPS_SRC_NAT_DONE 128
#define IPS_DST_NAT_DONE 256
#define IPS_CONFIRMED 8
#define IPS_DYING 512
#define NF_ACCEPT 1
#define NF_DROP 0
#define WARN_ON(x) (!!(x))
#define unlikely(x) (x)
